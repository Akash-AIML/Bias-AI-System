{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalyzeRequest",
  "type": "object",
  "properties": {
    "target": { "type": "string" },
    "sensitive": { "type": "string" },
    "prediction_column": { "type": "string" },
    "org_name": { "type": "string" },
    "dataset_name": { "type": "string" },
    "time_column": { "type": "string" },
    "text_columns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "target_binarization_threshold": { "type": "number" },
    "query": { "type": "string", "default": "check bias" },
    "file": { "type": "string", "description": "CSV file sent as multipart form-data" }
  },
  "required": ["target", "sensitive", "file"],
  "additionalProperties": false
}
